{
  "name": "specter",
  "productName": "Specter",
  "version": "1.0.0",
  "description": "Specter — an invisible, always-on-top AI overlay that sees your screen and hears your meetings. Groq-powered, BYO-key, fully local capture. Architecture reverse-engineered from Cluely v2.0.199.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "test:audio": "node scripts/test-audio-pipeline.mjs",
    "verify:cdp": "node scripts/verify-cdp.mjs 9333 4",
    "smoke": "electron-vite build && node scripts/smoke.js"
  },
  "dependencies": {
    "dompurify": "^3.1.7",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
